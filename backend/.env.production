# ============================================
# CIRCLE PAYMENTS - PRODUCTION CREDENTIALS
# ============================================
# TODO: Reemplazar con tus credenciales REALES de Circle Dashboard
# Obtener en: https://dashboard.circle.com/developer

CIRCLE_API_KEY=live_YOUR_REAL_CIRCLE_API_KEY_HERE
CIRCLE_ENTITY_SECRET=YOUR_REAL_CIRCLE_ENTITY_SECRET
CIRCLE_RECIPIENT_ADDRESS=0xYourRealWalletAddressHere123456789
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_REAL_ALCHEMY_KEY
PRIVATE_KEY=your_real_wallet_private_key

# ============================================
# AZURE INFRASTRUCTURE - PRODUCTION
# ============================================
# TODO: Crear Service Principal en Azure CLI:
# az ad sp create-for-rbac --name "twin-ai-infra" --role contributor --scopes /subscriptions/YOUR_SUBSCRIPTION_ID

AZURE_SUBSCRIPTION_ID=your_real_azure_subscription_id_here
AZURE_RESOURCE_GROUP=twin-ai-infra-prod
AZURE_TENANT_ID=your_real_azure_tenant_id
AZURE_CLIENT_ID=your_real_service_principal_client_id
AZURE_CLIENT_SECRET=your_real_service_principal_client_secret

# ============================================
# REDIS CACHE - PRODUCTION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_TLS_ENABLED=true
