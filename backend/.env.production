# === 🎯 Identidad del Servicio ===
NODE_ENV=production
PORT=3001
SERVICE_NAME=twin-ai-infra-backend
SERVICE_VERSION=1.0.0

# === 🔐 Autenticación JWT (Misybot Shared Secrets) ===
JWT_SECRET=XXX_REPLACE_WITH_REAL_JWT_SECRET_FROM_ENV
JWT_REFRESH_SECRET=XXX_REPLACE_WITH_REAL_REFRESH_SECRET
MISYBOT_TENANT_ID=misybot

# === 🌐 Misybot Backend Integration ===
MISYBOT_API_URL=https://realculture-backend-g3b9deb2fja4b8a2.canadacentral-01.azurewebsites.net
MISYBOT_AUTH_TOKEN=XXX_REPLACE_WITH_REAL_MISYBOT_TOKEN
MISYBOT_BACKEND_URL=https://realculture-backend-g3b9deb2fja4b8a2.canadacentral-01.azurewebsites.net

# === 💳 Circle Payment Gateway (Production) ===
# TODO: Reemplazar con credenciales REALES de Circle Dashboard
CIRCLE_API_KEY=live_xxx_REPLACE_WITH_REAL_CIRCLE_KEY
CIRCLE_ENTITY_SECRET=xxx_REPLACE_WITH_REAL_CIRCLE_SECRET
CIRCLE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
CIRCLE_WEBHOOK_SECRET=whsec_xxx_REPLACE_WITH_REAL_WEBHOOK_SECRET
CIRCLE_CHAIN_ID=8453
CIRCLE_CURRENCY=USDC

# === ☁️ Azure Infrastructure (Production) ===
# Service Principal para gestión de VMs
AZURE_SUBSCRIPTION_ID=REPLACE_WITH_YOUR_SUBSCRIPTION_ID
AZURE_CLIENT_ID=REPLACE_WITH_SERVICE_PRINCIPAL_CLIENT_ID
AZURE_CLIENT_SECRET=REPLACE_WITH_SERVICE_PRINCIPAL_SECRET
AZURE_TENANT_ID=REPLACE_WITH_YOUR_TENANT_ID
AZURE_RESOURCE_GROUP=realculture-infra
AZURE_REGION=canadacentral
AZURE_VM_SIZE=Standard_B2s
AZURE_SPOT_ENABLED=true

# === 🗄️ MongoDB Atlas / Cosmos DB ===
MONGODB_URI=XXX_REPLACE_WITH_REAL_MONGODB_URI
MONGODB_CONNECTION_STRING=XXX_REPLACE_WITH_REAL_MONGODB_URI
MONGODB_DB_NAME=twin-ai-infra
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# === 🧠 Azure Cache for Redis (Production) ===
REDIS_HOST=coach-redis-upgraded.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=XXX_REPLACE_WITH_REAL_REDIS_PASSWORD
REDIS_TLS=true
REDIS_TLS_ENABLED=true
REDIS_CONNECTION_STRING=XXX_REPLACE_WITH_REAL_REDIS_CONNECTION_STRING
REDIS_TTL=900
REDIS_SESSION_TTL=86400
REDIS_RATE_LIMIT_TTL=60

# === 🚀 Service Bus (Message Queue) ===
AZURE_SERVICE_BUS_CONNECTION_STRING=XXX_REPLACE_WITH_REAL_SERVICE_BUSConnectionString
SERVICE_BUS_QUEUE_NAME=meta-agent-queue
SERVICE_BUS_TOPIC=twin-ai-events

# === 🔒 Azure Key Vault (Encryption) ===
AZURE_KEY_VAULT_URL=https://realculture-keyvault.vault.azure.net
AZURE_KEY_VAULT_KEY_NAME=aegis-master-key
DATABASE_ENCRYPTION_KEY=XXX_REPLACE_WITH_REAL_ENCRYPTION_KEY

# === 📊 Azure OpenAI & AI Services ===
OPENAI_API_KEY=XXX_REPLACE_WITH_REAL_OPENAI_KEY
OPENAI_API_ENDPOINT=https://labsc-m9j5kbl9-eastus2.cognitiveservices.azure.com/
OPENAI_DEPLOYMENT_NAME=gpt-5.2-chat
OPENAI_MODEL=gpt-5.2-chat
OPENAI_API_VERSION=2025-04-01-preview
AZURE_SEARCH_SERVICE=realculture-search
AZURE_SEARCH_INDEX=content-index
AZURE_SEARCH_API_KEY=XXX_REPLACE_WITH_REAL_SEARCH_KEY

# === 🌐 CORS & Security ===
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://realculture-backend-g3b9deb2fja4b8a2.canadacentral-01.azurewebsites.net,https://misybot.com
ALLOWED_HOSTS=localhost,127.0.0.1,twin-ai-infra.azurewebsites.net
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# === 📈 Monitoring & Logging ===
APPINSIGHTS_INSTRUMENTATIONKEY=f392ed8a-1022-48be-8df4-5319d4d05c59
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=f392ed8a-1022-48be-8df4-5319d4d05c59;IngestionEndpoint=https://canadacentral-1.in.applicationinsights.azure.com/;LiveEndpoint=https://canadacentral.livediagnostics.monitor.azure.com/;ApplicationId=178ae3d7-5751-4181-a9d0-76529579cd84
LOG_LEVEL=info
ENABLE_DEBUG_LOGGING=false

# === 💾 PostgreSQL Sync (Misybot Azure DB) ===
DB_HOST=realculture-db.postgres.database.azure.com
DB_PORT=5432
DB_USERNAME=adminrealculture
DB_PASSWORD=XXX_REPLACE_WITH_REAL_DB_PASSWORD
DB_NAME=postgres
DB_SSL=true
DATABASE_URL=XXX_REPLACE_WITH_REAL_DATABASE_URL

# === 🎨 Frontend URLs ===
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MISYBOT_URL=https://realculture-backend-g3b9deb2fja4b8a2.canadacentral-01.azurewebsites.net

# === 🧪 Feature Flags ===
ENABLE_CIRCLE_PAYMENTS=true
ENABLE_AZURE_VMS=true
ENABLE_REDIS_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_JWT_AUTH=true
ENABLE_WEBHOOK_HANDLER=true
