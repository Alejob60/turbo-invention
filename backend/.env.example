# Twin AI Infrastructure- Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE (MongoDB)
# ============================================
MONGODB_URI=mongodb://localhost:27017/twin-ai-infra
# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/twin-ai-infra

# ============================================
# CIRCLE PAYMENTS
# ============================================
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here
CIRCLE_RECIPIENT_ADDRESS=0xYourCircleRecipientAddressHere
RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key
PRIVATE_KEY=your_wallet_private_key_for_onchain_operations

# Circle Webhooks (CRITICAL for payment settlement)
CIRCLE_WEBHOOK_SECRET=whsec_your_circle_webhook_secret_here

# ============================================
# AZURE INFRASTRUCTURE
# ============================================
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_RESOURCE_GROUP=twin-ai-infra-rg
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_service_principal_client_id
AZURE_CLIENT_SECRET=your_azure_service_principal_client_secret

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# ============================================
# MISYBOT INTEGRATION
# ============================================
MISYBOT_API_URL=https://realculture-backend-g3b9deb2fja4b8a2.canadacentral-01.azurewebsites.net
MISYBOT_API_KEY=your_misybot_api_key_here

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=debug
ENABLE_AUDIT_LOGS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100
